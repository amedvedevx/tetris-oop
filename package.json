    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  }
