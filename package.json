{
  "name": "tetris-oop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --ci",
    "build-storybook": "storybook build --quiet",
    "check": "npm run typecheck && npm run lint && npm run test:integration && npm run test:e2e",
    "test:integration": "vitest run",
    "test:e2e": "npm run build && npm run build-storybook && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/html-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
